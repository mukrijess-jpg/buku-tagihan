rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function myRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }

    // Profil akun (role, nama) - hanya bisa dibaca, ditulis manual lewat Firebase Console
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Data pelanggan - semua akun login boleh baca; hanya admin boleh tambah/ubah data identitas
    match /customers/{docId} {
      allow read: if isSignedIn();
      allow create, delete: if isSignedIn() && myRole() == 'admin';
      allow update: if isSignedIn();
      // Catatan: pembatasan "penagih hanya boleh ubah status/keterangan, bukan nama/harga"
      // saat ini ditegakkan di sisi aplikasi (UI). Untuk keamanan tingkat lanjut yang menolak
      // permintaan curang di level server, field mana yang boleh diubah tiap role perlu
      // ditambahkan di sini - bisa minta bantuan developer/Claude Code untuk pengetatan ini.
    }

    // Data pembayaran per bulan - semua akun login boleh baca & catat pembayaran
    match /payments/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }
  }
}
